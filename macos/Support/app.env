# The ONE place the app's identity lives. Change a value here and rebuild
# (./scripts/build-app.sh): the bundle, window, menus, menu bar, About box and
# every message pick it up. Code reads it at runtime through `AppInfo`.
APP_NAME="Kavach Console"
APP_SHORT_NAME="Kavach"
APP_TAGLINE="Armour for your Mac"
BUNDLE_ID="com.vss.kavachconsole"
# Executable inside the .app (matches the SwiftPM product).
EXECUTABLE="KavachConsole"
